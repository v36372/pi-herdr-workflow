{
  "name": "pi-herdr-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow engine for pi with Herdr pane dispatch, vendored herdr_layout/pane/agent tools, and subagent-style agent params",
  "keywords": [
    "pi-package",
    "workflow",
    "herdr",
    "subagent"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extension": {
      "types": "./src/extension/index.ts",
      "default": "./src/extension/index.ts"
    },
    "./child": {
      "types": "./src/child/extension.ts",
      "default": "./src/child/extension.ts"
    },
    "./herdr-tool": {
      "types": "./src/herdr/tool.ts",
      "default": "./src/herdr/tool.ts"
    }
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.101",
    "effect": "^4.0.0-beta.101",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typebox": "^1.3.6",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
